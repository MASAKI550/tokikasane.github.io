rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 地図に出す投稿（タイトル・場所・サムネイル）。誰でも読める。
    match /spots/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['title', 'year', 'note', 'lat', 'lng', 'heading', 'thumb', 'uid', 'created'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.year is string && request.resource.data.year.size() <= 30
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && (request.resource.data.heading == null || request.resource.data.heading is number)
        && request.resource.data.thumb is string && request.resource.data.thumb.size() < 60000
        && request.resource.data.created == request.time;
      // 消せるのは投稿した本人だけ（管理者は Firebase コンソールから削除）
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      // 「不適切な写真」の報告。1人1件。読めるのはコンソールからのみ。
      match /reports/{reporter} {
        allow create: if request.auth != null && request.auth.uid == reporter
          && request.resource.data.keys().hasOnly(['reason', 'created'])
          && request.resource.data.reason is string && request.resource.data.reason.size() <= 200
          && request.resource.data.created == request.time;
      }
    }

    // 写真本体（JPEG を文字列で保存。1件 1MB 未満）
    match /images/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['data', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && getAfter(/databases/$(database)/documents/spots/$(id)).data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
